# SevaSync Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Server
PORT=8080
NODE_ENV=development

# JWT Secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sevasync-replace-this-with-a-long-random-string

# Anthropic AI — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Firebase Firestore (OPTIONAL — app works in demo mode without this)
# Option A: drop serviceAccountKey.json in the project root (for local dev)
# Option B: paste the entire JSON as one line (for cloud deployments):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Your React frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
